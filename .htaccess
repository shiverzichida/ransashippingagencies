RewriteEngine On
RewriteBase /

# Apache/PHP hosting fallback only. Production routing is configured in vercel.json.

# Map /armada to armada.php
RewriteRule ^armada/?$ armada.php [L,QSA]

# Map /energi to energi.php
RewriteRule ^energi/?$ energi.php [L,QSA]

# Remove .php extension dynamically
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
